# ── LLM provider: ollama | google | openai ──
# Local default: ollama + Qwen (free, needs Ollama running)
# Render production: use google + GOOGLE_API_KEY (Ollama not available in cloud)
LLM_PROVIDER=ollama

# Google Gemini (free tier — https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL=gemini-1.5-flash

# Ollama (local / Docker only)
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_BASE_URL=http://host.docker.internal:11434

# OpenAI (paid — switch LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Backend CORS — comma-separated origins (Render env var)
# Example: https://devflow-ai.vercel.app,https://devflow-ai-git-main.vercel.app
CORS_ORIGINS=*

# Frontend (Vite) — see frontend/.env.example
# Vercel: VITE_API_BASE=https://YOUR_RENDER_SERVICE.onrender.com
VITE_API_BASE=http://localhost:8001
