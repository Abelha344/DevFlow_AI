# ── LLM provider: ollama | google | openai ──
# DEFAULT (free): ollama + Qwen — no API key, runs locally or via Docker
# Switch anytime by changing LLM_PROVIDER and restarting the backend.
LLM_PROVIDER=ollama

# Google Gemini (free tier — needs API key from https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL=gemini-1.5-flash

# Ollama (100% free, runs locally or via Docker)
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_BASE_URL=http://host.docker.internal:11434

# OpenAI (paid — switch LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Frontend (Vite) — leave blank in Docker; Nginx proxies /api
VITE_API_BASE=http://localhost:8000
